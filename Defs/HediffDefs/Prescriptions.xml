<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- One prescription hediff per drug. Severity = days remaining (drains 1/day). -->

  <HediffDef>
    <defName>Narcotics_Prescription_Percocet</defName>
    <label>percocet prescription</label>
    <description>A doctor's order to take percocet once per day until the course is finished.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.85, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <maxSeverity>30</maxSeverity>
    <comps>
      <li Class="Narcotics.HediffCompProperties_DrugPrescription">
        <drugDef>Percocet</drugDef>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>active course</label>
      </li>
    </stages>
  </HediffDef>

