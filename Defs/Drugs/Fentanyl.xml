<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MakeableDrugPillBase">
    <defName>Fentanyl</defName>
    <label>fentanyl</label>
    <description>A potent synthetic opioid synthesized from neutroamine and industrial medicine. Far stronger pain relief than percocet, with heavy sedation. Extremely addictive, and stacking doses readily causes overdose.\n\nAlso usable in place of medicine when anesthetizing a patient for surgery.</description>
    <descriptionHyperlinks>
      <HediffDef>FentanylHigh</HediffDef>
      <HediffDef>FentanylTolerance</HediffDef>
      <HediffDef>FentanylAddiction</HediffDef>
    </descriptionHyperlinks>
    <possessionCount>8</possessionCount>
    <graphicData>
      <texPath>Things/Item/Drug/Fentanyl</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <tradeability>All</tradeability>
    <statBases>
      <WorkToMake>900</WorkToMake>
      <MarketValue>32</MarketValue>
      <Mass>0.005</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <techLevel>Industrial</techLevel>
    <ingestible>
      <joyKind>Chemical</joyKind>
      <joy>0.12</joy>
      <nurseable>true</nurseable>
      <drugCategory>Medical</drugCategory>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>FentanylHigh</hediffDef>
          <severity>0.50</severity>
          <toleranceChemical>Fentanyl</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>FentanylTolerance</hediffDef>
          <toleranceChemical>Fentanyl</toleranceChemical>
          <severity>0.035</severity>
          <divideByBodySize>true</divideByBodySize>
          <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>FentanylProduction</researchPrerequisite>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <soundWorking>Recipe_Drug</soundWorking>
      <displayPriority>2250</displayPriority>
    </recipeMaker>
    <costList>
      <Neutroamine>3</Neutroamine>
      <MedicineIndustrial>1</MedicineIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>Fentanyl</chemical>
        <addictiveness>0.05</addictiveness>
        <minToleranceToAddict>0.10</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.25</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>1070</listOrder>
        <overdoseSeverityOffset>0.25~0.45</overdoseSeverityOffset>
        <largeOverdoseChance>0.02</largeOverdoseChance>
      </li>
    </comps>
    <allowedArchonexusCount>80</allowedArchonexusCount>
  </ThingDef>

  <HediffDef>
    <defName>FentanylHigh</defName>
    <label>fentanyl</label>
    <labelNoun>a fentanyl high</labelNoun>
    <description>Active fentanyl in the bloodstream. Extremely strong pain suppression with heavy sedation.</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.4</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>deep relief</label>
        <painFactor>0.25</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>heavy sedation</label>
        <painFactor>0.12</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.70</minSeverity>
        <label>near under</label>
        <painFactor>0.08</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>FentanylBuzz</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>FentanylHigh</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>fentanyl numbness</label>
        <description>The pain is far away. Everything feels distant and soft.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
      <li>
        <label>deep fentanyl calm</label>
        <description>Almost no pain. Heavy and quiet.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
      <li>
        <label>fentanyl fog</label>
        <description>Barely feel anything. Hard to stay awake.</description>
        <baseMoodEffect>14</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ChemicalDef>
    <defName>Fentanyl</defName>
    <label>fentanyl</label>
    <addictionHediff>FentanylAddiction</addictionHediff>
    <toleranceHediff>FentanylTolerance</toleranceHediff>
    <onGeneratedAddictedToleranceChance>0.85</onGeneratedAddictedToleranceChance>
    <geneToleranceBuildupFactorResist>0.5</geneToleranceBuildupFactorResist>
    <geneToleranceBuildupFactorImmune>0</geneToleranceBuildupFactorImmune>
    <geneOverdoseChanceFactorResist>0.5</geneOverdoseChanceFactorResist>
    <geneOverdoseChanceFactorImmune>0</geneOverdoseChanceFactorImmune>
  </ChemicalDef>

  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_Fentanyl</defName>
    <needClass>Need_Chemical</needClass>
    <label>fentanyl</label>
    <description>Because of a fentanyl addiction, this person needs to regularly take fentanyl to avoid withdrawal symptoms.</description>
    <listPriority>42</listPriority>
  </NeedDef>

  <HediffDef ParentName="DrugToleranceBase">
    <defName>FentanylTolerance</defName>
    <label>fentanyl tolerance</label>
    <description>A built-up tolerance to fentanyl. The more severe this tolerance is, the more fentanyl it takes to get the same effect.</description>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.015</severityPerDay>
      </li>
      <li Class="HediffCompProperties_DrugEffectFactor">
        <chemical>Fentanyl</chemical>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="AddictionBase">
    <defName>FentanylAddiction</defName>
    <label>fentanyl addiction</label>
    <description>A chemical addiction to fentanyl. Long-term presence of the opioid has caused neurological adaptations at the cellular level, so the brain can no longer function properly without the drug.
\nWithout regular doses of fentanyl, withdrawal symptoms will begin. However, extended abstinence will force the brain to adapt back to its normal state, resolving the addiction.</description>
    <hediffClass>Hediff_Addiction</hediffClass>
    <chemicalNeed>Chemical_Fentanyl</chemicalNeed>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.0333</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
      </li>
      <li>
        <label>withdrawal</label>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.18</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.12</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>Binging_DrugMajor</mentalState>
            <mtbDays>30</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>FentanylWithdrawal</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>FentanylAddiction</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <visible>false</visible>
      </li>
      <li>
        <label>fentanyl withdrawal</label>
        <description>Agony and craving. Nothing else matters except another dose.</description>
        <baseMoodEffect>-40</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
