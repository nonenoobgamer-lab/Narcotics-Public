<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef Name="Narcotics_PrescribeBase" Abstract="True" ParentName="SurgeryFlesh">
    <workerClass>Narcotics.Recipe_PrescribeDrug</workerClass>
    <jobString>Writing a drug prescription.</jobString>
    <workAmount>600</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <surgerySuccessChanceFactor>2.5</surgerySuccessChanceFactor>
    <surgeryIgnoreEnvironment>true</surgeryIgnoreEnvironment>
    <skillRequirements>
      <Medicine>3</Medicine>
    </skillRequirements>
  </RecipeDef>

  <!-- Percocet -->
  <RecipeDef ParentName="Narcotics_PrescribeBase">
    <defName>Narcotics_Prescribe_Percocet_3</defName>
    <label>prescribe percocet (3 days)</label>
    <description>Prescribe a 3-day course of percocet. The patient takes one dose during this visit, then once per day until the prescription ends. Requires a percocet pill for the first dose.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Percocet</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Percocet</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="Narcotics.PrescriptionExtension">
        <drugDef>Percocet</drugDef>
        <prescriptionHediff>Narcotics_Prescription_Percocet</prescriptionHediff>
        <days>3</days>
      </li>
    </modExtensions>
  </RecipeDef>

