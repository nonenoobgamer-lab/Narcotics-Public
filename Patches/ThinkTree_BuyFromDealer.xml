<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- After chemical need: try buying from a Narcotics drug dealer if colony stock is empty. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="MainColonistBehaviorCore"]/thinkRoot/subNodes/li[@Class="ThinkNode_PrioritySorter"]/subNodes/li[@Class="JobGiver_SatisfyChemicalNeed"]</xpath>
    <order>Append</order>
    <value>
      <li Class="Narcotics.JobGiver_BuyDrugFromDealer" />
    </value>
  </Operation>

</Patch>
